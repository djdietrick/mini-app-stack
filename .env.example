# --- Backend selection ---------------------------------------------------
# These pick which implementation each seam uses. The defaults below are the
# self-hosted Docker stack; the cloud (Firebase) deployment sets the other
# value for each. See README "Deploying to Firebase".
#
#   DATA_BACKEND    postgres  -> apps/*/src/repo/postgres.ts
#                   firestore -> apps/*/src/repo/firestore.ts
#   AUTH_MODE       stack     -> apps/auth + shared.sessions
#                   firebase  -> Firebase Auth session cookies
#   CACHE_BACKEND   redis | firestore
#   MAIL_TRANSPORT  smtp | http   (Cloud Functions cannot open SMTP ports)
DATA_BACKEND=postgres
AUTH_MODE=stack
CACHE_BACKEND=redis
MAIL_TRANSPORT=smtp

# Only set when running against the Firebase emulator suite
# (`pnpm emulators:up`). Leave empty for the plain Docker stack.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
GOOGLE_CLOUD_PROJECT=

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=appstack
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# --- App: auth ---
# Postgres password for the `auth_writer` login role created in
# infra/postgres/init/07-auth-role.sh.
APP_AUTH_PASSWORD=change_me_app_auth
AUTH_PORT=3100
# Shared secret apps include when calling /sessions/verify.
AUTH_VERIFY_SECRET=change_me_auth_verify_secret
# Cookie config. Leave AUTH_COOKIE_DOMAIN empty for localhost development;
# set to the shared parent (e.g. ".stack.local") so subdomains see the cookie.
AUTH_COOKIE_NAME=stack_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=2592000

# --- App: crate ---
APP_CRATE_PASSWORD=change_me_app_crate
CRATE_PORT=3101

# --- App: pantry ---
APP_PANTRY_PASSWORD=change_me_app_pantry
PANTRY_PORT=3102

# --- App: ytdigest ---
APP_YTDIGEST_PASSWORD=change_me_app_ytdigest
YTDIGEST_PORT=3103
# App-level key from https://console.cloud.google.com/apis/credentials (enable
# "YouTube Data API v3"). Single key for the whole app — only one user expected.
YOUTUBE_API_KEY=change_me_youtube_api_key
# SMTP relay for outbound digest emails (Gmail app password, self-hosted relay,
# or any provider's SMTP endpoint).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change_me_smtp_user
SMTP_PASSWORD=change_me_smtp_password
MAIL_FROM="YouTube Digest <change_me@example.com>"
# How often (minutes) subscribed channels are polled for new uploads/stats.
POLL_INTERVAL_MINUTES=180
# Cron expression (server local time) for the combined daily digest send.
DIGEST_SEND_CRON="0 8 * * *"
