# There is no backend switch here. Each deployment target has its own
# entrypoint: apps/*/src/index.ts wires Postgres, Redis and apps/auth
# (this file configures those), and functions/src/index.ts wires Firestore and
# Firebase Auth for the cloud. See README "Deploying to Firebase".

# Only set when running against the Firebase emulator suite
# (`pnpm emulators:up`). Leave empty for the plain Docker stack.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
GOOGLE_CLOUD_PROJECT=

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=appstack
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# --- App: auth ---
# Postgres password for the `auth_writer` login role created in
# infra/postgres/init/07-auth-role.sh.
APP_AUTH_PASSWORD=change_me_app_auth
AUTH_PORT=3100
# Shared secret apps include when calling /sessions/verify.
AUTH_VERIFY_SECRET=change_me_auth_verify_secret
# Cookie config. Leave AUTH_COOKIE_DOMAIN empty for localhost development;
# set to the shared parent (e.g. ".stack.local") so subdomains see the cookie.
AUTH_COOKIE_NAME=stack_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=2592000
# Optional Google sign-in. Leave the client values empty to offer email and
# password only. Create an OAuth client (type "Web application") in the Google
# Cloud console and register <origin>/auth/google/callback as a redirect URI
# for every origin below, e.g. http://localhost:3101/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated origins the apps are served from.
GOOGLE_ALLOWED_ORIGINS=http://localhost:3101,http://localhost:3102,http://localhost:3103,http://localhost:3104,http://localhost:3105,http://localhost:3106

# --- Landing page ---
LANDING_PORT=3000
# Where the landing page links to. Empty = http://localhost:<the app's port>.
VITE_APP_URL_CRATE=
VITE_APP_URL_PANTRY=
VITE_APP_URL_YTDIGEST=
VITE_APP_URL_FRETWORK=
VITE_APP_URL_CRUMB=
VITE_APP_URL_HIGHROLLER=

# --- App: crate ---
APP_CRATE_PASSWORD=change_me_app_crate
CRATE_PORT=3101

# --- App: pantry ---
APP_PANTRY_PASSWORD=change_me_app_pantry
PANTRY_PORT=3102

# --- App: ytdigest ---
APP_YTDIGEST_PASSWORD=change_me_app_ytdigest
YTDIGEST_PORT=3103
# App-level key from https://console.cloud.google.com/apis/credentials (enable
# "YouTube Data API v3"). Single key for the whole app — only one user expected.
YOUTUBE_API_KEY=change_me_youtube_api_key
# How often (minutes) subscribed channels are polled for new uploads/stats.
POLL_INTERVAL_MINUTES=60

# --- App: fretwork ---
APP_FRETWORK_PASSWORD=change_me_app_fretwork
FRETWORK_PORT=3104

# --- App: crumb ---
APP_CRUMB_PASSWORD=change_me_app_crumb
CRUMB_PORT=3105
# Reminders are Web Push only. MAIL_FROM is the push contact address
# (CRUMB_VAPID_SUBJECT overrides it).
MAIL_FROM="Crumb <change_me@example.com>"

# --- App: highroller ---
APP_HIGHROLLER_PASSWORD=change_me_app_highroller
HIGHROLLER_PORT=3106
