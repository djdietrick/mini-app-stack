{
  "indexes": [
    {
      "//": "GET /api/queue — filter by user, newest first.",
      "collectionGroup": "crate_queue",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "addedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "GET /api/queue?status= — same, with the status filter.",
      "collectionGroup": "crate_queue",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "addedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "GET /api/queue/random?genre= — queued albums in one genre.",
      "collectionGroup": "crate_queue",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "genre", "order": "ASCENDING" }
      ]
    },
    {
      "//": "POST /api/queue and /api/queue/status — dedupe and badge lookups.",
      "collectionGroup": "crate_queue",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "providerAlbumId", "order": "ASCENDING" }
      ]
    },
    {
      "//": "pantry GET /api/lists — one household's lists, newest first, LIMIT 100.",
      "collectionGroup": "pantry_lists",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "householdId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "pantry item-name uniqueness check: household + lowercased name.",
      "collectionGroup": "pantry_items",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "householdId", "order": "ASCENDING" },
        { "fieldPath": "nameKey", "order": "ASCENDING" }
      ]
    },
    {
      "//": "pantry tag-name uniqueness check: household + kind + lowercased name.",
      "collectionGroup": "pantry_tags",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "householdId", "order": "ASCENDING" },
        { "fieldPath": "kind", "order": "ASCENDING" },
        { "fieldPath": "nameKey", "order": "ASCENDING" }
      ]
    },
    {
      "//": "ytdigest: a channel's videos newest first (poll paging, tracked videos, baselines).",
      "collectionGroup": "ytdigest_videos",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "channelId", "order": "ASCENDING" },
        { "fieldPath": "publishedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "ytdigest digest candidates: a channel's videos first seen since the last digest.",
      "collectionGroup": "ytdigest_videos",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "channelId", "order": "ASCENDING" },
        { "fieldPath": "firstSeenAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "ytdigest: a video's latest snapshot, and the latest at or before a cutoff.",
      "collectionGroup": "ytdigest_snapshots",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "videoId", "order": "ASCENDING" },
        { "fieldPath": "capturedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "ytdigest GET /api/digests — ORDER BY run_date DESC, created_at DESC.",
      "collectionGroup": "ytdigest_digest_runs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "runDate", "order": "DESCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "ytdigest one-subscription-per-channel check.",
      "collectionGroup": "ytdigest_subscriptions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "channelId", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
