rules_version = '2';

// DENY ALL — this is intentional, do not "fix" it.
//
// Browsers never talk to Firestore directly in this stack. Every read and
// write goes through a Cloud Function using the Admin SDK, which bypasses
// security rules entirely. Keeping rules closed means a leaked Firebase web
// API key (which is public by design and shipped in every SPA bundle) grants
// no data access at all.
//
// If a future feature genuinely needs direct client access, open exactly that
// path — never the root match.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
